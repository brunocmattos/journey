# Supabase local (npm run banco mostra estes valores). Em produção, os do projeto no Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# "sim" mostra o botão "Entrar com Google" (o provedor precisa estar ligado no Supabase).
NEXT_PUBLIC_LOGIN_GOOGLE=nao
# Em produção, a URL pública do app (ex.: https://journey.exemplo.com); vazio no desenvolvimento.
# Com ela, os redirecionamentos e a conferência do Origin não confiam nos cabeçalhos X-Forwarded-*.
APP_URL=
